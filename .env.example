# Copy values into your server process environment. This file is NOT auto-loaded.
PLC_DATA_DIR=.local-data
# Keep disabled until the existing broker / AGENT01 path is approved for testing.
PLC_ENABLE_BROKER=false
# Set the actual value only in the server environment, never in the browser or Git.
PLC_BROKER_SEALED=
# Optional free local OCR: tesserocr + official eng/kor tessdata_fast files.
# No files are sent to any external OCR service.
PLC_TESSDATA_DIR=.local-ocr\tessdata
